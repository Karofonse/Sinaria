# Copia a .env (no commitear). Valores de desarrollo; en sandbox/prod usar un gestor de secretos.

# --- Base de datos y colas (docker-compose sobrescribe estos valores para sus servicios)
POSTGRES_PASSWORD=sonaria_dev
DATABASE_URL=postgresql+psycopg://sonaria:sonaria_dev@127.0.0.1:5432/sonaria
REDIS_URL=redis://127.0.0.1:6379/0

# --- Seguridad (generar con: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
DOWNLOAD_URL_SECRET=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# --- Proveedores musicales (todos desactivados por defecto)
DEFAULT_PROVIDER=mock
FAL_ENABLED=false
FAL_API_KEY=
STABILITY_ENABLED=false
STABILITY_API_KEY=

# --- Pagos Wompi (desactivado hasta autorización y credenciales sandbox)
PAYMENTS_ENABLED=false

# --- Almacenamiento privado
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./apps/api/.data/storage

# --- Límites
DAILY_GLOBAL_CREDIT_BUDGET=100000
USER_DAILY_CREDIT_LIMIT=1000
RATE_LIMIT_ENABLED=true

# --- Administrador inicial (solo para `python -m app.seed`; borrar después)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Frontend
API_INTERNAL_URL=http://127.0.0.1:8000
